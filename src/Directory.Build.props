<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Include and reference README in nuget package, if a README is in the project directory. -->
  <PropertyGroup>
    <PackageReadmeFile Condition="Exists('README.md')">README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- Packages that have shipped a stable release validate API compatibility against the latest stable version. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Nerdbank.Cryptocurrencies' or '$(MSBuildProjectName)' == 'Nerdbank.Zcash' or '$(MSBuildProjectName)' == 'Nerdbank.Bitcoin'">
    <PackageValidationBaselineVersion>0.5.29</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Condition="Exists('README.md')" Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove($(MSBuildThisFile), $(MSBuildThisFileDirectory)..))" />

</Project>
